# OpenBuild Environment Configuration
# Copy this to .env and fill in values

# Database
DATABASE_URL=postgres://openbuild:openbuild_dev@localhost:5432/openbuild
POSTGRES_PASSWORD=openbuild_dev

# Redis
REDIS_URL=redis://localhost:6379

# File Storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openbuild
MINIO_ACCESS_KEY=openbuild
MINIO_SECRET_KEY=openbuild_dev

# Search
MEILI_MASTER_KEY=openbuild_dev_key

# Auth
JWT_SECRET=change-this-in-production

# API Server
LISTEN_ADDR=0.0.0.0:3000
