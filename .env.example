DATABASE_URL=sqlite:///instance/app.db
API_AUTH_ENABLED=true
API_KEY_HEADER=X-API-Key
API_HMAC_ENABLED=false
API_SIGNATURE_HEADER=X-Signature
API_TIMESTAMP_HEADER=X-Timestamp
API_TIMESTAMP_TOLERANCE_SECONDS=300
API_KEY_DEFAULT_TTL_DAYS=0
API_KEY_AUTO_EXPIRY_ENABLED=true
API_KEY_EXPIRY_CHECK_SECONDS=900
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_BURST=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IDENTIFIER_HEADER=X-API-Key
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
ALLOWED_ORIGINS=["*"]
METRICS_KEY=
METRICS_KEY_HEADER=X-Metrics-Key
METRICS_CACHE_SECONDS=15
METRICS_CACHE_OVERRIDES=
METRICS_CACHE_BYPASS_QUERY=refresh
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT_POINT=secret
VAULT_PATH_PREFIX=task-registry/api-keys
VAULT_VERIFY_SSL=true
VAULT_VERIFY_WRITES=false
VAULT_TRANSIT_KEY=
VAULT_TRANSIT_KEY_VERSION=
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DESTINATION=stdout
AUDIT_LOG_FILE_PATH=
AUDIT_LOG_HTTP_ENDPOINT=
AUDIT_QUEUE_ENABLED=false
AUDIT_QUEUE_BACKEND=memory
AUDIT_QUEUE_KAFKA_BOOTSTRAP=
AUDIT_QUEUE_KAFKA_TOPIC=
AUDIT_QUEUE_MEMORY_MAXSIZE=10000
