# Copy to .env and tweak as needed.
# Custom user agent to respect OpenStreetMap Nominatim usage policy.
GEOCODER_USER_AGENT=localweathergpt
# Optional: configure Meteostat cache directory to reduce network calls.
METEOSTAT_CACHE_DIR=.cache/meteostat
# Required for Visual Crossing Timeline API requests.
VISUAL_CROSSING_API_KEY=
# Required for NOAA Climate Data Online (CDO) API requests.
NOAA_TOKEN=
# Optional override for the NOAA GHCND station ID (e.g., GHCND:USW00014815).
NOAA_STATION_ID=
